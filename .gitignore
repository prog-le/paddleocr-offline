# 依赖安装
.venv/
venv/
*.egg-info/
__pycache__/
*.py[cod]

# 运行期产物
data/
logs/
dist/
*.log
data/.session_secret

# 随包运行时（解包目录 & 本地安装标记）
.runtime/
.runtime_env
.venv_path

# 离线物料（体积大，不入库）
offline/wheels/*/*.whl
offline/wheels-gpu/*/*.whl
offline/wheels/*/wheel-list.txt
offline/wheels-gpu/*/wheel-list.txt
offline/wheels*/*/.requirements-*.txt
offline/python/*/*.tar.gz
offline/python/*/*.sha256
models/paddlex_home/official_models/*
!models/paddlex_home/official_models/.gitkeep
# PaddleX 模型下载锁（运行期产物）
models/paddlex_home/locks/
# Indra OCR 权重（体积大，不入库）
models/indra/*
!models/indra/.gitkeep

# 系统噪音
.DS_Store
.idea/
.vscode/
