# Docker Compose 环境变量示例（复制为 .env 后修改）
# cp .env.example .env

# ---- 镜像 ----
# 离线导入镜像后，务必把 IMAGE 改成 docker load 出来的实际 tag
IMAGE=paddlex-ocr-web:1.0.0-amd64
APP_VERSION=1.0.0
# 构建时使用的架构（amd64 / arm64），仅在 --build 时生效
TARGETARCH=amd64

# ---- 服务 ----
CONTAINER_NAME=paddlex-ocr-web
HOST_PORT=8000
TZ=Asia/Shanghai

# ---- 运行时参数 ----
# 管理员密码（留空则用 config/config.yaml 中的值，建议在此设置）
ADMIN_PASSWORD=PaddleX@2026
# 并发推理任务数（CPU 建议 1）
CONCURRENCY=1
PDF_DPI=200
LOG_LEVEL=INFO
RETENTION_HOURS=24
# 容器内存上限（产线是按需加载的，只有用到的才占内存）
#   单产线（OCR / 精简 / 表格）        ：4g 起
#   同时用两条（如精简 + 表格）        ：8g 起
#   四条都用过（未卸载，内存累加）      ：12g 起
# 建议按机器实际内存设置，并保留 1~2g 给系统
# 注意：mem_limit 太小 → 任务跑到一半容器被 OOM kill（docker ps 里表现为“自动重启”）
MEM_LIMIT=8g

# ---- 数据与日志目录（相对 docker/ 目录）----
DATA_DIR=../data
LOG_DIR=../logs

# ---------------------------------------------------------------- 运行设备（GPU）
# auto = 有 NVIDIA GPU 就用，否则 CPU；也可写 cpu / gpu:0
OCR_DEVICE=auto
# 显存池占卡比例（0~0.95，0=Paddle 默认按需增长）；给了 MB 就按卡总显存换算
GPU_MEM_FRACTION=0
GPU_MEM_LIMIT_MB=0
# 文本识别 batch：CPU 建议 6~8，GPU 可调到 16~32
TEXT_REC_BATCH=8
# 只挂部分卡时改成数量（配合 docker-compose.gpu.yml 的 device reservations）
GPU_COUNT=all
